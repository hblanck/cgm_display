# CGM Display - Environment Configuration Example
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Do NOT commit .env to git - it's in .gitignore for security
# This file (.env.example) shows what variables are available

# ===============================================================================
# DEXCOM MODE CONFIGURATION
# ===============================================================================

# Dexcom Share API credentials
# Required for: python cgm_display.py dexcom
# Source: Your Dexcom Follow app credentials
DEXCOM_USERNAME=your_dexcom_username
DEXCOM_PASSWORD=your_dexcom_password

# ===============================================================================
# NIGHTSCOUT MODE CONFIGURATION
# ===============================================================================

# Nightscout server URL
# Required for: python cgm_display.py nightscout
# Example: https://yourname.herokuapp.com or https://nightscout.example.com
NIGHTSCOUT_SERVER=https://your-nightscout-server.com

# ===============================================================================
# OPTIONAL: POLLING AND DISPLAY SETTINGS
# ===============================================================================

# How often to fetch new readings (seconds)
# Default: 60 for Nightscout, 180 for Dexcom
# CGM_POLLING_INTERVAL=60

# How often to update the "time ago" display (seconds)
# Default: 30
# CGM_TIME_AGO_INTERVAL=30

# Logging level: INFO or DEBUG
# Default: INFO
# CGM_LOG_LEVEL=INFO

# ===============================================================================
# DOCKER USAGE EXAMPLES
# ===============================================================================

# Example 1: Docker with .env file
#   docker run --env-file .env cgm-display cgm_display.py dexcom
#
# Example 2: Docker with inline environment variables
#   docker run \
#     -e DEXCOM_USERNAME=myuser \
#     -e DEXCOM_PASSWORD=mypass \
#     cgm-display cgm_display.py dexcom
#
# Example 3: Docker Compose with .env file (automatically loaded)
#   docker-compose up -d
#
# Example 4: Docker with Nightscout
#   docker run --env-file .env cgm-display cgm_display.py nightscout

# ===============================================================================
# IMPORTANT SECURITY NOTES
# ===============================================================================

# 1. NEVER commit .env to git
#    - It's in .gitignore for security
#    - Contains plaintext credentials
#
# 2. Keep .env file secure
#    - Restrict file permissions: chmod 600 .env
#    - Store securely in production
#
# 3. For production use:
#    - Use Docker Secrets or Kubernetes Secrets instead
#    - Use CI/CD secret management (GitHub Secrets, GitLab CI/CD Variables)
#    - Never store credentials in Dockerfile or docker-compose.yml
#
# 4. Rotate credentials regularly
#    - Change Dexcom password if .env is ever exposed
#    - Use different credentials for different environments

# ===============================================================================
# DOCKER COMPOSE EXAMPLE
# ===============================================================================

# Save this as docker-compose.yml to run with docker-compose:
#
# version: '3.8'
# services:
#   cgm-display:
#     build: .
#     env_file: .env
#     environment:
#       - CGM_LOG_LEVEL=INFO
#     stdin_open: true
#     tty: true
#     # For Raspberry Pi with physical display:
#     # volumes:
#     #   - /dev/fb1:/dev/fb1
#     # devices:
#     #   - /dev/fb1:/dev/fb1
